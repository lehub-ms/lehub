# Copy to .env.local (git-ignored). Vite inlines VITE_* values at build time, so
# these are public: never put a secret here.
#
# Origin of the Function App. Local: the func host. Cloud: injected by the workflow
# from the environment's variables. The two front-ends always call the API
# cross-origin — see vite.config.ts.

VITE_API_BASE_URL=http://localhost:7071
