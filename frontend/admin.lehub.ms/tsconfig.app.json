{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],

      /* Le pendant, pour tsc, du `dedupe` de vite.config.ts. `@lehub/shared` déclare React,
         lucide-react et react-router en peerDependencies : c'est l'application qui les fournit.
         Mais le socle en installe ses propres copies pour se type-checker seul, et sans ces
         chemins tsc voit deux `LucideIcon` et deux `Ref<SVGSVGElement>` sans rapport dès qu'un
         composant partagé en expose un dans ses props. La règle est la même que pour le bundle —
         une seule copie — écrite ici pour le compilateur. */
      "react": ["./node_modules/@types/react", "./node_modules/react"],
      "react-dom": ["./node_modules/@types/react-dom", "./node_modules/react-dom"],
      "lucide-react": ["./node_modules/lucide-react"],
      "react-router": ["./node_modules/react-router"]
    }
  },
  "include": ["src", "test"]
}
