# Reference for the generated `.env.local`, which is git-ignored. ./scripts/dev-up.sh and
# ./scripts/dev-start.sh rewrite it on every run from this workspace's slot, so editing it
# by hand has no effect past the next run.
#
# Vite inlines VITE_* values at build time, so they are public: never put a secret here.
#
#   VITE_API_BASE_URL  origin of the Function App. Local: the func host of this workspace's
#                      slot. Cloud: injected by the workflow from the environment's
#                      variables. Both front-ends always call the API cross-origin — see
#                      vite.config.ts.
#   VITE_ADMIN_BASE_URL
#                      origin of the backoffice. Offered from the account menu to an
#                      account that is a global administrator or organises at least one
#                      community — see #137. Cloud: injected by the workflow from the
#                      environment's admin Static Web App.
#   VITE_DEV_PORT      port the Vite dev server binds, derived from the slot.
#   VITE_DEV_HOST      interface the dev server binds. `localhost` by default;
#                      `dev-start.sh --network` sets `0.0.0.0` so a phone on the same
#                      network can reach it.
#   VITE_ENTRA_*       the Entra External ID tenant to sign users in against. Local: the
#                      dev tenant, borrowed — there is no local one. Cloud: the tenant of
#                      the environment being built. Identifiers, never credentials.
#                      AUTHORITY carries the tenant's subdomain; the issuer the API checks
#                      carries its GUID instead, and the two are not interchangeable.

VITE_API_BASE_URL=http://localhost:7071
VITE_ADMIN_BASE_URL=http://localhost:5174
VITE_DEV_PORT=
VITE_DEV_HOST=localhost
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=
