# Local development environment. Template only — `.env` itself is git-ignored.
#
# Do not copy this file by hand: run ./scripts/dev-up.sh, which writes `.env` with a
# freshly generated password. No working credential is committed, not even a local
# one, so every workspace gets its own.
#
# This is the single source of the local SQL password: docker-compose.yml reads it,
# and dev-up.sh propagates it into api/local.settings.json.

MSSQL_SA_PASSWORD=
